{
  "name": "legion-battles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames --outDir dist-crazygames",
    "preview": "vite preview",
    "test": "vitest run",
    "art": "tsx scripts/art.ts",
    "art:sheet": "tsx scripts/sheet.ts",
    "typecheck": "tsc --noEmit",
    "balance": "tsx scripts/balance.ts",
    "journey": "tsx scripts/journey.ts",
    "samples": "node scripts/samples.mjs",
    "listen": "node scripts/listen.mjs"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
