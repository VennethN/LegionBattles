{
  "name": "lastander",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5175 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames --outDir dist-crazygames",
    "package:crazygames": "npm run build:crazygames && mkdir -p build && rm -f build/lastander-crazygames.zip && cd dist-crazygames && zip -q -r -9 ../build/lastander-crazygames.zip .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "art": "tsx scripts/art.ts",
    "pace": "tsx scripts/pace.ts",
    "walk": "tsx scripts/walk.ts",
    "art:preview": "tsx scripts/preview.ts",
    "check": "tsc --noEmit && vitest run && vite build",
    "art:sheet": "tsx scripts/sheet.ts",
    "smoke": "tsx scripts/smoke.ts",
    "art:roster": "tsx scripts/roster.ts",
    "film": "tsx scripts/film.ts",
    "cover": "tsx scripts/cover.ts",
    "art:pages": "tsx scripts/pages.ts"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
